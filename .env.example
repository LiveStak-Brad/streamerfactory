# Copy to .env.local and fill in. Do not commit .env.local (see .gitignore).

# Supabase — Project Settings → Connect / API Keys
# https://supabase.com/dashboard/project/_/settings/api-keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
# Server-only: required for TikTok token storage (RLS blocks direct client access to tiktok_connections).
# Also used by other privileged jobs when set.
SUPABASE_SERVICE_ROLE_KEY=

# Site origin for links in emails and absolute URLs (Vercel: your production URL)
NEXT_PUBLIC_SITE_URL=https://thestreamerfactory.com

# Email auth: enable Email under Authentication → Providers. Add redirect URLs for
# confirmation links, e.g. http://localhost:3000/auth/callback

# Resend — https://resend.com (API key + verified sending domain)
RESEND_API_KEY=re_your_api_key
# Display name + address (must match a verified domain in Resend)
RESEND_TRANSACTIONAL_FROM="Streamer Factory <team@thestreamerfactory.com>"
# Plain address or same as above; used for internal /apply alerts if configured
RESEND_FROM_EMAIL=team@thestreamerfactory.com

# TikTok Login Kit (member dashboard — connect + sync)
# https://developers.tiktok.com/doc/login-kit-web
# Redirect URI must match exactly (HTTPS in production). Example:
# TIKTOK_REDIRECT_URI=https://thestreamerfactory.com/api/tiktok/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# TikTok URL prefix verification: host the portal's downloaded `tiktok*.txt` at site root, plus
# /terms/<filename> and /privacy/<filename> (see public/*.txt and public/terms/, public/privacy/).
# Replace file bodies with the exact bytes from TikTok's download if Verify still fails.
#
# TikTok URL verification lines (middleware GET /, /terms, /privacy probes; OAuth + webhook GET use TIKTOK_SITE_VERIFICATION):
# TIKTOK_SITE_VERIFICATION=tiktok-developers-site-verification=your_token_here
# Optional when TikTok gives a different token for root prefix (https://www.example.com/):
# TIKTOK_ROOT_SITE_VERIFICATION=tiktok-developers-site-verification=your_root_prefix_token
# Optional when TikTok gives a different token for /privacy/ prefix verification only:
# TIKTOK_PRIVACY_SITE_VERIFICATION=tiktok-developers-site-verification=your_privacy_prefix_token
#
# Webhooks (Products → Webhooks → Callback URL), same domain:
#   https://thestreamerfactory.com/api/tiktok/webhook
# The route always returns 200 for portal tests; TIKTOK_CLIENT_SECRET is used to verify
# HMAC before running DB handlers (e.g. authorization.removed).
# Share Kit: in the portal set your website / domain to NEXT_PUBLIC_SITE_URL (e.g. https://thestreamerfactory.com).
# Content Posting: configure in portal; video.* events POST to the webhook above.
#
# Local only: allow webhook POST without valid TikTok-Signature (portal "Test" can fail without it). Never set in production.
# TIKTOK_WEBHOOK_SKIP_SIGNATURE_VERIFY=true

# Optional: notify yourself when someone submits /apply (set one or both)
# Discord: Server Settings → Integrations → Webhooks → New Webhook → copy URL
# APPLICATION_NOTIFY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# APPLICATION_NOTIFY_EMAIL=you@yourdomain.com
