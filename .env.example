# Supabase — copy to .env.local and fill in (Project Settings → Connect / API Keys)
# https://supabase.com/dashboard/project/_/settings/api-keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# New publishable key (sb_publishable_...) or legacy anon key from the dashboard
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Email auth: enable Email under Authentication → Providers. Add redirect URLs for
# confirmation links, e.g. http://localhost:3000/auth/callback

# Optional: base URL for links in notification emails (defaults to production domain in code)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: notify yourself when someone submits /apply (set one or both)
# Discord: Server Settings → Integrations → Webhooks → New Webhook → copy URL
# APPLICATION_NOTIFY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Email via Resend (https://resend.com): create API key, verify sending domain or use onboarding@resend.dev for tests
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Streamer Factory <onboarding@resend.dev>
# APPLICATION_NOTIFY_EMAIL=you@yourdomain.com
