# Supabase — copy to .env.local and fill in (Project Settings → Connect / API Keys)
# https://supabase.com/dashboard/project/_/settings/api-keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# New publishable key (sb_publishable_...) or legacy anon key from the dashboard
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
